{
  "name": "@react-todos/client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed React Query client for the react-todos example, generated from its OpenAPI document.",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./react-query": { "types": "./dist/react-query.d.ts", "import": "./dist/react-query.js" }
  },
  "files": ["dist"],
  "scripts": {
    "dump": "NEXTRS_SKIP_BUNDLE=1 cargo run -p react-todos --bin dump-openapi",
    "orval": "orval --config ./orval.config.ts",
    "gen": "npm run dump && npm run orval && cargo build -p react-todos && npm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tanstack/react-router": "^1.87.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "orval": "^7.3.0",
    "typescript": "^5.7.0"
  }
}
