{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "react-todos-realtime",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_ROOMS",
        "class_name": "RealtimeRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RealtimeRoom"]
    }
  ],
  "vars": {
    "APP_URL": "http://localhost:3000"
  },
  "observability": {
    "enabled": true
  }
}
